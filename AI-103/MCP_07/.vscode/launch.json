{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Agent Deployment",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/agent_deployment.py",
            "console": "integratedTerminal",
            "python": "tutorials/Scripts/python.exe",
            "env": {
                "PROJECT_ENDPOINT": "https://courseunit412.services.ai.azure.com/api/projects/courseunit412-proj",
                "LLM_MODEL_DEPLOYMENT_NAME": "courseunit412-llm-deploy",
                "MCP_SERVER_ENDPOINT_1": "https://mcp.exa.ai/mcp",
                "MCP_SERVER_ENDPOINT_2": "https://app.trip-planner.com.au/api/mcp",
                "MCP_SERVER_ENDPOINT_3": "https://open-meteo.caseyjhand.com/mcp",
            }
        },
        {
            "name": "Python Debugger: Agent Execution",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/agent_execution.py",
            "console": "integratedTerminal",
            "python": "tutorials/Scripts/python.exe",
            "env": {
                "PROJECT_ENDPOINT": "https://courseunit412.services.ai.azure.com/api/projects/courseunit412-proj",
                "AGENT_NAME": "MCPAgent",
                "AGENT_VERSION": "1"
            }
        },
    ]
}
