{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Agent Deployment",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/agent_deployment.py",
            "console": "integratedTerminal",
            "python": "tutorials/Scripts/python.exe",
            "env": {
                "PROJECT_ENDPOINT": "https://courseunit432.services.ai.azure.com/api/projects/courseunit432-proj",
                "LLM_MODEL_DEPLOYMENT_NAME": "courseunit432-llm-deploy",
                "FILE_TO_UPLOAD": "inputs/MacBook_Air_3000.pdf"
            }
        },
        {
            "name": "Python Debugger: Agent Execution",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/agent_execution.py",
            "console": "integratedTerminal",
            "python": "tutorials/Scripts/python.exe",
            "env": {
                "PROJECT_ENDPOINT": "https://courseunit432.services.ai.azure.com/api/projects/courseunit432-proj",
                "AGENT_NAME": "llmAgent",
                "AGENT_VERSION": "1"
            }
        },
    ]
}
