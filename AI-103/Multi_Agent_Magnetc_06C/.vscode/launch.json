{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Agent Deployment",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/agent_deployment.py",
            "console": "integratedTerminal",
            "python": "tutorials/Scripts/python.exe",
            "env": {
                "PROJECT_ENDPOINT": "https://courseunit624.services.ai.azure.com/api/projects/courseunit624-proj",
                "LLM_MODEL_DEPLOYMENT_NAME": "courseunit624-llm-deploy",
            }
        },
        {
            "name": "Python Debugger: Agent Execution",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/agent_execution.py",
            "console": "integratedTerminal",
            "python": "tutorials/Scripts/python.exe",
            "env": {
                "PROJECT_ENDPOINT": "https://courseunit624.services.ai.azure.com/api/projects/courseunit624-proj",
                "MANAGER_AGENT_NAME": "manager-agent",
                "EXTRACTOR_AGENT_NAME": "extractor-agent",
                "ANALYST_AGENT_NAME": "analyst-agent",
            }
        },
    ]
}
